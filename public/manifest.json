{
  "manifest_version": 3,
  "name": "Proxy Management Extension by FlashProxy",
  "short_name": "FlashProxy",
  "version": "0.3.0",
  "description": "Switch between your FlashProxy plans and your own proxies, with smart rules.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "proxy",
    "storage",
    "alarms",
    "activeTab",
    "webRequest",
    "webRequestAuthProvider",
    "browsingData"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FlashProxy",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "dashboard.html"
}
