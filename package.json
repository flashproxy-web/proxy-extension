{
  "name": "proxy-extension",
  "private": true,
  "version": "0.3.0",
  "description": "Switch between FlashProxy plans and proxies from any provider, with per-site rules. Manifest V3 extension for Chrome and Chromium browsers.",
  "keywords": [
    "proxy",
    "proxy-switcher",
    "chrome-extension",
    "manifest-v3",
    "pac",
    "socks5",
    "flashproxy",
    "residential-proxy",
    "browser-extension"
  ],
  "homepage": "https://github.com/flashproxy-web/proxy-extension#readme",
  "bugs": {
    "url": "https://github.com/flashproxy-web/proxy-extension/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flashproxy-web/proxy-extension.git"
  },
  "license": "GPL-3.0-only",
  "author": "FlashProxy (https://www.flashproxy.com)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "pac-check": "esbuild scripts/pac-check.ts --bundle --platform=node --log-level=warning --outfile=.cache/pac-check.cjs && node .cache/pac-check.cjs",
    "e2e": "node e2e/run.mjs",
    "test": "npm run pac-check && npm run build && npm run e2e",
    "shots": "node scripts/screenshots.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:fsd": "steiger ./src/popup && steiger ./src/dashboard && steiger ./src/welcome",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "knip": "knip"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.2.2",
    "axios": "1.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "0.544.0",
    "radix-ui": "1.8.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "7.89.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@puppeteer/browsers": "3.2.7",
    "@tailwindcss/vite": "4.1.13",
    "@types/chrome": "0.0.287",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.3.4",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.25.12",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "eslint-plugin-unused-imports": "4.4.1",
    "flag-icons": "7.2.3",
    "globals": "16.4.0",
    "knip": "5.66.0",
    "prettier": "3.9.4",
    "prettier-plugin-tailwindcss": "0.6.14",
    "puppeteer-core": "25.18.1",
    "steiger": "0.10.0",
    "tailwindcss": "4.1.13",
    "tw-animate-css": "1.3.8",
    "typescript": "5.6.3",
    "typescript-eslint": "8.62.1",
    "vite": "6.4.6"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.9"
    }
  }
}
